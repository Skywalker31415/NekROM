c-----------------------------------------------------------------------
      subroutine rom_userrhs(rom_rhs)

      include 'SIZE'
      include 'TOTAL'
      include 'MOR'

      if (ifrom(1).and.ifield.eq.1) then
        write(*,*) 'ADDING TO RHS', ''
        call add2s2(rom_rhs,rf,param(2),nb)
      endif

      return
      end
