c-----------------------------------------------------------------------
      subroutine usrdat2
      include 'SIZE'
      include 'TOTAL'

      common /hartmn/ Ha

      ifuservp = .true. ! Get props from uservp

      Ha = 10.  ! Hartmann number for case Re=Rm=1


      return
      end
c-----------------------------------------------------------------------
      subroutine rom_userchk

      include 'SIZE'
      include 'TOTAL'
      include 'AVG'
      include 'MOR'

      parameter (lt=lx1*ly1*lz1*lelt)
      parameter (ltot1=lx1*ly1*lz1*lelt)

      common /scrsetb/ bxx(lt),byy(lt),bzz(lt),bwk(lb+1)
      common /scrsetf/ wk1(ltot1),wk2(ltot1),wk3(ltot1),wk(lb+1)

      logical ifexist
      real temp(0:nb)
      integer z
      integer n
      real ubar, vbar, wbar

      ntot =nx1*ny1*nz1*nelv


      call reconv(vx,vy,vz,u)
      if (ifrom(ifldb)) call reconb(bx,by,bz,b)
      call hpts
      
       if (.false.) then
c      if (ad_step.eq.0) then
            do i=1,lsu
                  call pv2b(temp,us0(1,1,i),us0(1,2,i),us0(1,3,i)
     $            ,ub,vb,wb)
                  do z=0,nb
                        write(*,*) 'u projection: ', i, temp(z)
                  enddo
            enddo
            do i=1,lsu
                  call pv2b(temp,bs0(1,1,i),bs0(1,2,i),bs0(1,3,i)
     $            ,bxb,byb,bzb)
                  do z=0,nb
                        write(*,*) 'b projection: ', i, temp(z)
                  enddo
            enddo

            

            do i=0,nb
            write(*,*) 'ubasisnorms ', 
     $         op_glsc2_wt(ub(1,i),vb(1,i),wb(1,i), 
     $         ub(1,i),vb(1,i),wb(1,i), bm1)  
            write(*,*) 'bbasisnorms ', 
     $         op_glsc2_wt(bxb(1,i),byb(1,i),bzb(1,i), 
     $         bxb(1,i),byb(1,i),bzb(1,i), bm1) 


              call sub_mean(bxb(1,i),byb(1,i),bzb(1,i)) 
            call outpost(bxb(1,i),byb(1,i),bzb(1,i),
     $                  pb(1,i),tb(1,i,1),'zzz')

             write(*,*) 'ubasisnorms2 ', 
     $         op_glsc2_wt(ub(1,i),vb(1,i),wb(1,i), 
     $         ub(1,i),vb(1,i),wb(1,i), bm1)  
            write(*,*) 'bbasisnorms2 ', 
     $         op_glsc2_wt(bxb(1,i),byb(1,i),bzb(1,i), 
     $         bxb(1,i),byb(1,i),bzb(1,i), bm1)  

            enddo
            
      endif


      write(6,1) ad_step,time,(u(k),k=1,nb),(b(k),k=1,nb)
    1 format(i9,1p9e12.4,' coefs')


      if (ad_step.eq.0) then
            
         if (rmode.eq.'ON '.or.rmode.eq.'CP ') then
            inquire (file='ops/rf',exist=ifexist)
            if (ifexist) call read_serial(rf,nb,'ops/rf ',wk,nid)
         else
            write(*,*) 'BUILDING', ''
            call copy(fz,bm1,ntot)
            call cmult(fz,1.0,ntot)
            call rzero(fy,ntot)
            call rzero(fx,ntot)

            ! Construct body force operator by
            ! integrating test function with body force
            call rzero(rf,nb)
            do i=1,nb
               rf(i)=glsc2(ub(1,i),fx,ntot)+glsc2(vb(1,i),fy,ntot)
               if (ldim.eq.3) rf(i)=rf(i)+glsc2(wb(1,i),fz,ntot)
               if (nio.eq.0) write (6,*) rf(i),i,'rf'
            enddo
            call dump_serial(rf,nb,'ops/rf ',nid)

            ! Verify that the body force is 2
            call opcopy(wk1,wk2,wk3,fx,fy,fz)
            call opbinv1(wk1,wk2,wk3,wk1,wk2,wk3,1.)
            iftmp=ifxyo
            ifxyo=.true.
            call outpost(wk1,wk2,wk3,pavg,tavg,'fff')
            ifxyo=iftmp
         endif
      endif

      if (ad_step.eq.nsteps) then
            write(*,*) 'writing averages', ''
            n    = lx1*ly1*lz1*nelv
            wbar = glsc2(bz,bm1,n)/volvm1
            write(*,*) 'averages: ', wbar
      endif

      return
      end
